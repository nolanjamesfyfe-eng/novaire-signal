{
  "version": 2,
  "buildCommand": "node scripts/verify-build.js",
  "outputDirectory": ".",
  "functions": {
    "api/quote-post.js": {
      "maxDuration": 60
    },
    "api/quote-auth.js": {
      "maxDuration": 10
    },
    "api/signal-feed.js": {
      "maxDuration": 30
    },
    "api/portfolio-auth.js": {
      "maxDuration": 10
    },
    "api/portfolio-gate.js": {
      "maxDuration": 10
    },
    "api/market-futures.js": {
      "maxDuration": 10
    },
    "api/commodities.js": {
      "maxDuration": 10
    },
    "api/zerohedge.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/quote-studio/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}

{
  "version": 2,
  "buildCommand": "node scripts/verify-build.js",
  "outputDirectory": ".",
  "functions": {
    "api/quote-post.js": {
      "maxDuration": 60
    },
    "api/quote-auth.js": {
      "maxDuration": 10
    },
    "api/signal-feed.js": {
      "maxDuration": 30
    },
    "api/portfolio-auth.js": {
      "maxDuration": 10
    },
    "api/portfolio-gate.js": {
      "maxDuration": 10
    },
    "api/market-futures.js": {
      "maxDuration": 10
    },
    "api/commodities.js": {
      "maxDuration": 10
    },
    "api/zerohedge.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/videoOS/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/quote-studio/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ],
  "redirects": [
    { "source": "/map", "destination": "/flaneur", "permanent": true },
    { "source": "/map/", "destination": "/flaneur", "permanent": true },
    { "source": "/map/index.html", "destination": "/flaneur", "permanent": true },
    { "source": "/flaneur/", "destination": "/flaneur", "permanent": true }
  ],
  "rewrites": [
    { "source": "/flaneur", "destination": "/map/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}

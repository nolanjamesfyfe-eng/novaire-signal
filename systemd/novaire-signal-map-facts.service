[Unit]
Description=Refresh sourced capital, population, and nominal GDP facts for Novaire Signal map
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
WorkingDirectory=/root/clawd/novaire-signal
ExecStart=/root/clawd/novaire-signal/scripts/refresh_map_facts.sh
StandardOutput=append:/root/clawd/logs/novaire-signal-map-facts.log
StandardError=append:/root/clawd/logs/novaire-signal-map-facts.log
TimeoutStartSec=30min
